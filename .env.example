# Onde a API guarda os dados: memory (padrao, sem banco, some ao reiniciar) ou postgres (Supabase)
STORAGE=memory

# Auth. JWT_SECRET assina os tokens: sem ele (ou com menos de 32 caracteres) a API nao sobe.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
TOKEN_MINUTOS=30
# Admin criado na primeira subida se ainda nao existir (senha com 10+ caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Maior corpo de pedido aceito, em bytes (padrao 65536 = 64 KiB). Acima disso: 413
MAX_BODY_BYTES=65536

# Fator dos KPIs de impacto: kg por refeicao. PREMISSA do grupo, sem fonte ainda (docs/kpis.md)
KG_POR_REFEICAO=0.5

# Supabase (projeto rede-alimenta-ia, free tier) - session pooler, IPv4
# Se a senha tiver caracteres especiais, precisa dar percent-encode nela antes de colar aqui
SUPABASE_DB_URL=postgresql://postgres.wsluwfuaarxayfppttzf:[SUA-SENHA]@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# MongoDB Atlas (cluster Cluster0, free tier M0)
MONGODB_URI=mongodb+srv://rafa120207_db_user:[SUA-SENHA]@cluster0.segnaic.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
