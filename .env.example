# Copie pra .env (que o git ignora) e preencha. Aqui so vao placeholders: nenhum valor real.
# No Render, estas mesmas variaveis entram no painel (ver render.yaml e docs/deploy-render.md).

# Onde a API guarda os dados: memory (padrao, sem banco, some ao reiniciar) ou postgres (Supabase).
# Em producao tem que ser postgres; com memory a API sobe sem reclamar e perde tudo a cada deploy.
STORAGE=memory

# Auth. JWT_SECRET assina os tokens: sem ele (ou com menos de 32 caracteres) a API nao sobe.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
TOKEN_MINUTOS=30
# Admin criado na primeira subida se ainda nao existir (senha com 10+ caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Maior corpo de pedido aceito, em bytes (padrao 65536 = 64 KiB). Acima disso: 413
MAX_BODY_BYTES=65536

# Deixe desligado fora do Render. Com 1, o IP do cliente (limite de pedidos e log) vem do
# cabecalho CF-Connecting-IP; fora de um proxy que o sobrescreva, qualquer cliente forja.
# CONFIAR_CF_CONNECTING_IP=1

# Fator dos KPIs de impacto: kg por refeicao. PREMISSA do grupo, sem fonte ainda (docs/kpis.md)
KG_POR_REFEICAO=0.5

# Supabase (session pooler, IPv4). Pegue em Project Settings > Database > Connection string.
# Se a senha tiver caracteres especiais, precisa dar percent-encode nela antes de colar aqui.
# Obrigatoria so com STORAGE=postgres.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:[SUA-SENHA]@<host-do-pooler>:5432/postgres

# So pro infra/db/test_connections.py (comparacao de bancos do dia 3); a API nao usa.
MONGODB_URI=mongodb+srv://<usuario>:[SUA-SENHA]@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<app>

# So pros scripts que falam com a API por HTTP (api/seed_dev.py, infra/db/testar_login.py)
# API_URL=http://localhost:8000
